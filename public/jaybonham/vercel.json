{
  "cleanUrls": true,
  "functions": {
    "api/jb-subscribe.py": {
      "maxDuration": 10
    },
    "api/jb-slots.py": {
      "maxDuration": 15
    },
    "api/jb-book.py": {
      "maxDuration": 15
    },
    "api/aff.py": {
      "maxDuration": 15
    },
    "api/whop-hook.py": {
      "maxDuration": 15
    },
    "api/jb-apply.py": {
      "maxDuration": 10
    },
    "api/admin-auth.py": {
      "maxDuration": 10
    },
    "api/admin-leads.py": {
      "maxDuration": 15
    },
    "api/admin-lead.py": {
      "maxDuration": 15
    },
    "api/admin-send.py": {
      "maxDuration": 15
    },
    "api/admin-emails.py": {
      "maxDuration": 15
    },
    "api/admin-inbox.py": {
      "maxDuration": 15
    },
    "api/vt.py": {
      "maxDuration": 10
    },
    "api/tv-aff.py": {
      "maxDuration": 20
    },
    "api/tv-members.py": {
      "maxDuration": 30
    },
    "api/tv-setup.py": {
      "maxDuration": 20
    },
    "api/jb-webinar.py": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.jaybonham.com"
        }
      ],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/webinar",
      "destination": "/workshop",
      "permanent": false
    },
    {
      "source": "/webinar/:path*",
      "destination": "/workshop/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "admin.jaybonham.com"
        }
      ],
      "destination": "/admin/:path+"
    }
  ]
}
